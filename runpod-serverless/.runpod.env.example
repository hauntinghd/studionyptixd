# RETIRED STUDIO RUNPOD CONFIGURATION
#
# The Studio API, production queue consumer, persistent state, ClipLab, and
# media-generation policy are owned by the Contabo release contract. The
# RunPod deployment/upsert helpers in this directory fail before reading
# credentials or making a network request.
#
# These explicit values document the only supported production posture.
STUDIO_RUNPOD_PRODUCTION_ENABLED=false
STUDIO_RUNPOD_LONGFORM_ENABLED=false
RUNPOD_COMPOSITOR_ENABLED=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_CLIPLAB_ENDPOINT_ID=
XAI_API_KEY=

# Canonical public callbacks remain on the Contabo-owned API.
API_PUBLIC_URL=https://api-studio.nyptidindustries.com
GOOGLE_REDIRECT_URI=https://api-studio.nyptidindustries.com/api/oauth/google/youtube/callback
PAYPAL_WEBHOOK_URL=https://api-studio.nyptidindustries.com/api/paypal/webhook
