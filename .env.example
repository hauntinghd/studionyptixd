# NYPTID Studio Agent (OpenRouter)
# Get a key at https://openrouter.ai/keys — NEVER commit the real key.
OPENROUTER_API_KEY=
STUDIO_AGENT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_HTTP_REFERER=https://studio.nyptidindustries.com
OPENROUTER_APP_TITLE=NYPTID Studio Agent

# YouTube Data API (server-side quota — separate from OAuth)
# Google Cloud Console → APIs & Services → Credentials → Create API key
# Restrict to YouTube Data API v3 + YouTube Analytics API
YOUTUBE_API_KEY=
YOUTUBE_API_KEYS=

# ClipLab internal OpusClip bridge (server-side only; do not expose in frontend)
# local = Studio/Catalyst native clipping, opus = OpusClip, hybrid = Opus if configured else local
CLIPLAB_PROVIDER=local
OPUSCLIP_API_KEY=
OPUSCLIP_ORG_ID=
OPUSCLIP_POLL_INTERVAL_SEC=20
OPUSCLIP_POLL_TIMEOUT_SEC=2400

# xAI Grok Imagine (server-side only; do not expose in frontend)
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video
XAI_STT_LANGUAGE=en
FAL_PUBLIC_RENDERS_ENABLED=1
XAI_PUBLIC_RENDERS_ENABLED=1
STUDIO_FREE_TRIAL_DAYS=3
STUDIO_FREE_TRIAL_CREDITS=1000
STUDIO_FREE_TRIAL_IP_COOLDOWN_DAYS=180
STUDIO_TRIAL_MAX_PROVIDER_USD=10
