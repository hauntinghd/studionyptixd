# Copy to /opt/studio/shared/restic-s3.env only after provisioning a private
# S3-compatible bucket. The operational script treats presence of that file as
# an instruction to upload every quiesced local snapshot off-host.
#
# Use the provider's exact HTTPS path-style endpoint and a private bucket/path.
# Example shape only (not a real endpoint or bucket):
# RESTIC_REPOSITORY=s3:https://object-storage.example.invalid/private-bucket/nyptid-studio
RESTIC_REPOSITORY=

# Store a strong restic repository password in this separate root-owned
# mode-0600 file and keep an offline recovery copy. Never put the password here.
RESTIC_PASSWORD_FILE=/opt/studio/shared/restic-password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default

# Applied only by the explicit `restic_offsite.sh maintenance` command.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
