# Copy to /opt/studio/shared/studio.env, set mode 0600, and fill values from
# the current production secret store. Never commit the populated file.
#
# REDIS_URL, worker counts, provider routing, public URLs, and filesystem paths
# are intentionally owned by docker-compose.yml and must not be added here.
#
# STUDIO_ORIGIN_TOKEN is deliberately absent. It belongs only in the Caddy
# container and Cloudflare Worker secret store; use caddy.env.example.

ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
STUDIO_AGENT_PRIMARY_PROVIDER=anthropic

FAL_AI_KEY=
FAL_AI_KEY_2=
FAL_AI_KEY_3=
FAL_AI_KEY_4=
FAL_AI_KEY_5=
FAL_AI_KEY_6=

ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_API_KEYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Copy the exact redirect URI registered with Google after the backend-domain
# cutover; do not guess or silently retain a retired origin.
GOOGLE_REDIRECT_URI=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_STRIPE_PRIMARY=true
STRIPE_TOPUP_PUBLIC_ENABLED=true

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

ALGROW_API_KEY=
PIKZELS_API_KEY=
OPUSCLIP_API_KEY=
CLIPLAB_PROVIDER=
STUDIO_ERROR_WEBHOOK_URL=

# Compose overrides this value to empty and hard-disables every legacy xAI/Grok
# runtime switch. A stale saved value therefore cannot authorize Studio calls.
XAI_API_KEY=
