# Copy to /opt/studio/shared/caddy.env, set mode 0600, and generate a unique
# base64url token of at least 43 characters. The populated file must never be
# committed, printed, or copied into the Studio API container.
STUDIO_ORIGIN_TOKEN=

# Optional during a zero-downtime rotation only. Set this to the old token while
# STUDIO_ORIGIN_TOKEN contains the new token, then clear it after the Worker has
# switched to the new secret.
STUDIO_ORIGIN_TOKEN_PREVIOUS=
