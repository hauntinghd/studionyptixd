[Unit]
Description=NYPTID Studio quiesced local recovery snapshot (not disaster recovery)
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/studio/shared/active.env
ConditionPathExists=!/opt/studio/shared/consumer.disabled

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/studio/current
ExecStart=/usr/bin/bash /opt/studio/current/ops/contabo/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
TimeoutStartSec=6h
